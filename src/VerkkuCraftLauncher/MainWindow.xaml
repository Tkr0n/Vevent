<ui:FluentWindow x:Class="VerkkuCraftLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:viewModels="clr-namespace:VerkkuCraftLauncher.ViewModels"
        xmlns:converters="clr-namespace:VerkkuCraftLauncher.Converters"
        Title="VerkkuCraft Launcher" 
        Icon="/Assets/img/icon.jpg"
        Width="700" Height="650"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1a1a2e"
        Foreground="White">

    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark"/>
                <ui:ControlsDictionary/>
            </ResourceDictionary.MergedDictionaries>
            <converters:SvgImageSourceConverter x:Key="SvgImageSourceConverter"/>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar with buttons -->
        <Grid Grid.Row="0" Background="#0f1a30" Height="40" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="VerkkuCraft Launcher" VerticalAlignment="Center" 
                       Foreground="#888" FontSize="12" Margin="15,0,0,0"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="—" Width="40" Height="40" Background="Transparent" 
                        Foreground="#888" BorderThickness="0" FontSize="14"
                        Click="MinimizeButton_Click"/>
                <Button Content="✕" Width="40" Height="40" Background="Transparent" 
                        Foreground="#888" BorderThickness="0" FontSize="14"
                        Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Logo -->
            <Image Grid.Row="0" 
                   Source="/Assets/img/banner.jpg"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,20"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

        <!-- Status Text -->
        <TextBlock Grid.Row="1"
                   Text="{Binding StatusMessage}"
                   FontSize="12"
                   Foreground="#aaa"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <!-- Progress Bar + Detail -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <ProgressBar Value="{Binding DownloadPercent}" Height="6" Margin="0,0,0,6"
                         IsIndeterminate="{Binding IsProgressIndeterminate}"
                         Maximum="100" Foreground="#4fc3f7" Background="#1a3a5c"/>
            <TextBlock Text="{Binding DownloadDetail}"
                       FontSize="11"
                       Foreground="#666"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Username Input -->
        <StackPanel Grid.Row="3" Margin="0,15,0,0">
            <TextBlock Text="Tu nombre de jugador:" FontSize="14" Foreground="#888" Margin="0,0,0,5"/>
            <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                       PlaceholderText="Ingresa tu nombre..."
                       Icon="{ui:SymbolIcon Person24}"
                       FontSize="16"/>
        </StackPanel>

        <!-- VPN Status -->
        <Border Grid.Row="4" Background="#0f3460" CornerRadius="8" Padding="15" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔒" FontSize="20" VerticalAlignment="Center"/>
                <StackPanel Margin="10,0,0,0">
                    <TextBlock Text="Tailscale VPN" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Necesario para voz UDP" FontSize="12" Foreground="#888"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Play Button -->
        <ui:Button Grid.Row="5" 
                   Content="🎮 JUGAR"
                   Command="{Binding JugarCommand}"
                   IsEnabled="{Binding IsJugarEnabled}"
                   Appearance="Primary"
                   FontSize="20"
                   FontWeight="Bold"
                   Height="60"
                   Margin="0,20,0,0"
                   HorizontalAlignment="Stretch"/>
    </Grid>
    </Grid>
</ui:FluentWindow>
