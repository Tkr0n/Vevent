# ==================================
# Build y Temporales de Gradle
# ==================================
.gradle/

# Ignorar todo el contenido de la carpeta build...
build/*
# ...PERO permitir que Git entre a la carpeta de salida (libs)
!build/libs/

# Dentro de libs, ignorar todo (por si hay archivos temporales)...
build/libs/*
# ...PERO permitir y subir los archivos .jar finales
!build/libs/*.jar

# (Opcional) Si decides usar el wrapper de Gradle
!gradle/wrapper/gradle-wrapper.jar

# ==================================
# Archivos compilados de Java
# ==================================
*.class
*.log
*.war
*.ear
hs_err_pid*
replay_pid*

# Ignoramos cualquier otro .jar que ande suelto por ahí
# (Pero la excepción de !build/libs/*.jar de arriba lo sobreescribe para el output)
*.jar

# ==================================
# Visual Studio Code / Cursor / OpenCode
# ==================================
.vscode/
.factorypath

# ==================================
# IntelliJ IDEA
# ==================================
.idea/
*.iml
*.iws
*.ipr
out/

# ==================================
# Eclipse
# ==================================
.settings/
.classpath
.project
bin/

